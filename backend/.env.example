PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Authentication. Replace both secrets before deploying.
AUTH_REQUIRED=true
JWT_ACCESS_SECRET=change-this-access-secret-to-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-to-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ALLOW_ROLE_SELF_ASSIGNMENT=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# API protection and structured logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info

# file (zero-config local development) or postgres
STORAGE_DRIVER=file
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pune_climate

# fixture (zero-config) or python (real GEE + SegFormer pipeline)
ML_MODE=fixture
PYTHON_COMMAND=python
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_KEY_PATH=
MODEL_PATH=../models/segformer-pune

# Background jobs. Leave empty to run assessment/notifications synchronously.
REDIS_URL= redis://localhost:6379

# local, s3 or firebase
FILE_STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional outbound notifications; in-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=climate-platform@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# LLM providers — the assistant bridge tries Groq first, then Gemini.
# Groq (free tier: 30 req/min, ~1,000 req/day, OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Gemini fallback (free tier; resets daily)
GEMINI_API_KEY=
