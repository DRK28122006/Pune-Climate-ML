{
  "name": "pune-climate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MVP API for the Urban Climate Intelligence platform",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers.js",
    "worker:dev": "node --watch src/workers.js",
    "seed": "node scripts/seed.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --test"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@google-cloud/storage": "^8.0.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "twilio": "^5.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
