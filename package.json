{
  "name": "pune-climate-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "check": "npm run typecheck --workspace frontend && npm run check --workspace backend"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22"
  }
}
