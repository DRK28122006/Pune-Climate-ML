# then: ml_pipeline/cli.py build-data
ml_pipeline/data/census/
*.kml
*.geojson
*.tif
*.tiff
*.nc
*.pbf
*.sqlite
*.db
data/
geodata/

# Exception: the tree-index BUILDER is source code and must be tracked.
# Only the built .sqlite (52 MB, re-derivable from the census) is ignored.
!ml_pipeline/data/
!ml_pipeline/data/*.py
!ml_pipeline/data/__init__.py

node_modules/
dist/
